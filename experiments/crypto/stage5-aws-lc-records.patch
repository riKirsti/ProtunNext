+
+/// Experimental Stage 5 record-cipher comparison. Keep the existing TLS policy:
+/// suite order/identities, key exchanges, randomness, signing and verification.
+/// Only the implementations behind the advertised record suites are replaced.
+pub(crate) fn record_crypto_provider() -> Result<rustls::crypto::CryptoProvider> {
+    let mut provider = rustls::crypto::ring::default_provider();
+    let candidate = rustls::crypto::aws_lc_rs::default_provider();
+    provider.cipher_suites = provider
+        .cipher_suites
+        .iter()
+        .map(|suite| {
+            candidate
+                .cipher_suites
+                .iter()
+                .find(|other| other.suite() == suite.suite())
+                .copied()
+                .ok_or(Error::Invalid("TLS record cipher unavailable"))
+        })
+        .collect::<Result<Vec<_>>>()?;
+    Ok(provider)
+}
