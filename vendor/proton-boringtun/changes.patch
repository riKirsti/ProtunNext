+    /// Data-path variant with plaintext already at buffer[16..16 + packet_len].
+    /// Handshake queuing and all timers/statistics retain the standard path's rules.
+    #[cfg(feature = "in-place")]
+    pub fn encapsulate_in_place<'a>(&mut self, buffer: &'a mut [u8], packet_len: usize) -> TunnResult<'a> {
+        assert!(buffer.len() >= (packet_len + DATA_OVERHEAD_SZ).max(HANDSHAKE_INIT_SZ));
+        let current = self.current;
+        if let Some(ref session) = self.sessions[current % N_SESSIONS] {
+            let packet = session.format_packet_data_in_place(packet_len, buffer);
+            self.timer_tick(TimerName::TimeLastPacketSent);
+            if packet_len != 0 { self.timer_tick(TimerName::TimeLastDataPacketSent); }
+            self.tx_bytes += packet_len;
+            return TunnResult::WriteToNetwork(packet);
+        }
+        self.queue_packet(&buffer[16..16+packet_len]);
+        self.format_handshake_initiation(buffer, false)
+    }
+
+    /// Only for data messages. Handshakes and cookie replies use decapsulate.
+    #[cfg(feature = "in-place")]
+    pub fn decapsulate_data_in_place<'a>(&mut self, buffer: &'a mut [u8]) -> TunnResult<'a> {
+        // RateLimiter::verify_packet applies MAC/rate limiting only to handshake
+        // messages; its data path is exactly this shared parser (see upstream).
+        let (receiver, counter) = match tunn_parse_incoming_packet(buffer) {
+            Ok(Packet::PacketData(packet)) => (packet.receiver_idx, packet.counter),
+            Ok(_) => return TunnResult::Err(WireGuardError::InvalidPacket),
+            Err(e) => return TunnResult::Err(e),
+        };
+        let idx = receiver as usize % N_SESSIONS;
+        let len = match self.sessions[idx].as_ref() {
+            Some(session) => match session.receive_packet_data_in_place(receiver, counter, &mut buffer[16..]) {
+                Ok(packet) => packet.len(), Err(e) => return TunnResult::Err(e),
+            },
+            None => return TunnResult::Err(WireGuardError::NoCurrentSession),
+        };
+        self.set_current_session(receiver as usize);
+        self.timer_tick(TimerName::TimeLastPacketReceived);
+        self.validate_decapsulated_packet(&mut buffer[16..16+len])
+    }
