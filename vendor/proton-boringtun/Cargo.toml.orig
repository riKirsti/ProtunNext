[package]
name = "proton-boringtun"
description = "Fork of CloudFlare BoringTUN: an implementation of the WireGuard® protocol designed for portability and speed"
version = "4.9.0"
authors = [
    "Noah Kennedy <nkennedy@cloudflare.com>",
    "Andy Grover <agrover@cloudflare.com>",
    "Jeff Hiner <jhiner@cloudflare.com>",
]
license = "BSD-3-Clause"
readme = "README.md"
repository = "https://github.com/cloudflare/boringtun"
documentation = "https://docs.rs/boringtun/0.7.1/boringtun/"
edition = "2018"
# Keeps dev-dependency features (thread_rng for tests and benches) out of the library build.
resolver = "2"

[profile.release]
lto = true        # Enable full link-time optimization.
codegen-units = 1 # Use only 1 codegen-unit to enable full optimizations.

[profile.bench]
lto = true        # Enable full link-time optimization.
codegen-units = 1 # Use only 1 codegen-unit to enable full optimizations.

[features]
default = []
disable-queuing = []

[dependencies]
tracing = {version = "0.1.40", default-features = false, features = ["attributes"]}
ring = {version = "0.17", default-features = false, features = ["alloc"]}
x25519-dalek = { version = "3", features = ["reusable_secrets", "static_secrets"] }

rand = { version = "0.10", default-features = false, features = ["alloc"] }
chacha20poly1305 = {version="0.10", default-features=false, features = ["alloc"]}
aead = "0.5.0-pre.2"
blake2 =  { version = "0.10", default-features = false }
hmac = "0.12"

[dependencies.proton-os-interface]
version = "0.3.3"
registry = "proton"

[dev-dependencies]
etherparse = "0.13"
rand = { version = "0.10", features = ["thread_rng"] }
tracing-subscriber = "0.3"
criterion = { version = "0.8.2", features = ["html_reports"] }

[lib]
crate-type = ["staticlib", "cdylib", "rlib"]

[[bench]]
name = "crypto_benches"
harness = false
